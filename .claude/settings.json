{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(claims-eval *)",
      "Bash(python -m claims.eval *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.sh\"",
            "timeout": 120,
            "statusMessage": "Running offline tests..."
          }
        ]
      }
    ]
  }
}
