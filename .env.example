# Claude
ANTHROPIC_API_KEY=
CLAIMS_MODEL=claude-sonnet-5-5      # handles most claims
CLAIMS_COMPLEX_MODEL=claude-opus-5-5   # re-reads uncertain documents and checks complex claims; set to CLAIMS_MODEL to turn off
CLAIMS_EFFORT=high                  # low | medium | high | xhigh | max
CLAIMS_MAX_COVERAGE_TURNS=8         # after this, the claim goes to a person

# Limits
CLAIMS_MAX_PER_DAY=2000             # hard daily cap, which also limits API spend
CLAIMS_MAX_ATTACHMENTS=10
CLAIMS_MAX_ATTACHMENT_MB=20

# Storage: checkpoints, mock claims system, attachments, outbox, audit log
CLAIMS_DATA_DIR=data
CLAIMS_POLICY_FILE=config/mock_policies.yaml
CLAIMS_RULES_FILE=config/rules.yaml   # fast-track rules: limits, required fields and evidence by line of business
